{
  "schemaVersion": 1,
  "id": "alloygery",
  "version": "${version}",
  "name": "Alloygery",
  "description": "Enhancing progression by adding new ores and alloys, and a system where tools and armor are crafted from a combination of parts.",
  "icon": "assets/alloygery/icon.png",
  "authors": [
    "Brotazoa"
  ],
  "contact": {
    "repo": "https://github.com/brotazoa/Alloygery"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "client": [
      "amorphia.alloygery.Alloygery"
    ],
    "main": [
      "amorphia.alloygery.Alloygery"
    ],
    "fabric-datagen": [
      "amorphia.alloygery.Alloygery"
    ],
    "emi": [
      "amorphia.alloygery.compat.recipeViewers.emi.AlloygeryEmiPlugin"
    ],
    "rei_client": [
      "amorphia.alloygery.compat.recipeViewers.rei.AlloygeryReiPlugin"
    ]
  },
  "mixins": [
    "alloygery.accessor.mixins.json",
    "alloygery.gear.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version}"
  }
}
